      "parameters": {
        "jsCode": "const bloques = $input.all().map(({ json: fila }) => {\n  const vacante = String(fila.vacante ?? '').trim();\n  const pregunta = String(fila.pregunta ?? '').trim();\n  const respuesta = String(fila.respuesta ?? '').trim();\n\n  if (!vacante || !pregunta || !respuesta) {\n    throw new Error(`FAQ incompleta en la fila ${fila.row_number ?? '?'}.`);\n  }\n\n  return `Vacante: ${vacante}\\nPregunta: ${pregunta}\\nRespuesta: ${respuesta}`;\n});\n\nreturn [{ json: { data: bloques.join('\\n\\n') } }];"
      },
